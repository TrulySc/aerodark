    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as fh:
        fh.write(page)
    return path


def main():
    here = os.path.dirname(os.path.realpath(__file__))
    ap = argparse.ArgumentParser(description="Use your Plasma icon theme in Discord (Vesktop).")
    ap.add_argument("--theme", help="icon theme (default: the one Plasma is using)")
    ap.add_argument("--size", type=int, default=24, help="preferred icon size in px (default 24)")
    ap.add_argument("--out", help="output file (default ~/.config/vesktop/themes/AeroIcons.theme.css)")
    ap.add_argument("--map", help="icon-map.json")
    ap.add_argument("--emoji-font", default="", help='emoji font for AeroEmoji (default: your system emoji font)')
    ap.add_argument("--no-emoji", action="store_true", help="don't write AeroEmoji.theme.css")
    ap.add_argument("--halo", action="store_true", help="faint light outline around icons on dark schemes")
    ap.add_argument("--add-pack", metavar="ZIP_OR_FOLDER", nargs="+", help="add icon pack(s) to pick from in the catalog")
    ap.add_argument("--apply-picks", metavar="JSON", help="use the picks saved from the catalog (aerodark-picks.json)")
    ap.add_argument("--no-fetch-avatar", action="store_true", help="don't download your Discord picture for Messenger")
    ap.add_argument("--catalog", action="store_true", help="open the icon catalog in your browser afterwards")
    ap.add_argument("--which", nargs="+", metavar="NAME", help="just show which file each icon name resolves to")
    ap.add_argument("--if-changed", action="store_true", help="only run if the icon theme changed")
    a = ap.parse_args()

    if a.add_pack:
        for pk in a.add_pack:
            add_pack(pk)
        a.catalog = True
    if a.apply_picks:
        apply_picks(a.apply_picks)
    theme = a.theme or current_theme()
    if a.which:
        th = chain(theme)
        for n in a.which:
            print(f"{n}: {lookup(th, [n], a.size) or 'not in ' + theme}")
        return
    stamp = os.path.join(STATE, "discord-icon-theme")
    stamp_text = theme + "|" + scheme_colors().get("Text", "") + "|" + custom_stamp() + "|" + str(len(os.listdir(os.path.join(STATE, "discord"))) if os.path.isdir(os.path.join(STATE, "discord")) else 0)
    if a.if_changed and os.path.isfile(stamp) and open(stamp).read().strip() == stamp_text:
        return
    mpath = a.map or next((p for p in (os.path.join(here, "icon-map.json"),
                                       os.path.join(DATA, "aerodark/discord/icon-map.json")) if os.path.isfile(p)), None)
    if not mpath:
        sys.exit("icon-map.json not found (keep it next to this script).")
    entries = json.load(open(mpath))
    out = a.out or os.path.join(CONF, "vesktop/themes/AeroIcons.theme.css")

    themes, extra = chain(theme), [t for t in [Theme(EXTRA_THEME)] if t.roots]
    rules, from_theme, from_extra = [], 0, 0
    big = max(a.size * 2, 48)            # the server list draws icons at about 48 px

    # Performance: every :has() rule is re-checked whenever Discord adds an <svg>, so each icon gets
    # exactly ONE cheap child-only :has() (to paint the replacement on its <svg>); its paths are
    # hidden with plain attribute selectors, which cost nothing.
    # Windows 7's icons are drawn for light backgrounds; many (microphone, headset, cameras) are dark
    # grey objects that vanish on Aero Dark. On a dark scheme each icon gets a faint light outline —
    # the same trick Windows used for icons on dark glass.
    global HALO
    tc = scheme_colors().get("Text", "#000000")
    dark = (int(tc[1:3], 16) * 299 + int(tc[3:5], 16) * 587 + int(tc[5:7], 16) * 114) / 1000 > 128
    HALO = (" filter: drop-shadow(0 0 0.6px rgba(255,255,255,0.75)) drop-shadow(0 0 2px rgba(255,255,255,0.22));"
            if dark and a.halo else "")
    owners = {}                          # path d → ids of every icon that uses it
    for e in entries:
        for pth in e["paths"]:
            owners.setdefault(pth["d"], set()).add(e["id"])
    chosen, from_custom, origin = [], 0, {}
    for e in entries:
        cf = custom_file(*custom_keys(e))
        if cf:
            from_custom += 1
            chosen.append((e, None, [cf], cf))
            origin[e["id"]] = ("your pick", cf)
            continue
        names = e["names"]
        f = lookup(themes, names, a.size) if names else None
        src = themes
        if f:
            from_theme += 1
        else:
            f = lookup(extra, [e["slug"]], a.size)
            if not f:
                continue
            src, names = extra, [e["slug"]]
            from_extra += 1
        chosen.append((e, src, names, f))
        origin[e["id"]] = (theme if src is themes else EXTRA_THEME, f)
    replaced = {e["id"] for e, *_ in chosen}

    hide = []
    for e, src, names, f in chosen:
        # key on the path that's most specific to this icon
        k = min(range(len(e["paths"])), key=lambda i: len(owners[e["paths"][i]["d"]]))
        sel = f'svg:has(> path[d^="{e["match"][k]}"])'
        rules.append(f'{sel} {{ background: url("{data_uri(f)}") center / contain no-repeat !important;{HALO} }}')
        for i, pth in enumerate(e["paths"]):
            if owners[pth["d"]] <= replaced:
                hide.append(f'path[d^="{e["match"][i]}"]')
            else:                         # shared with an icon we're not replacing: hide only here
                hide.append(f'{sel} > path[d^="{e["match"][i]}"]')
        if e["id"] in GUILD_IDS:          # drawn large in the server list
            fb = (lookup(src, names, big) if src else None) or f
            rules.append(f'#app-mount [class*="guilds_"] {sel} {{ width: 32px !important; height: 32px !important; '
                         f'background-image: url("{data_uri(fb)}") !important; background-size: 32px 32px !important; }}')
    if hide:
        rules.append(",\n".join(dict.fromkeys(hide)) + " { visibility: hidden !important; }")
    # server list: folder/plus/explore at the size of the tile contents, but small badges (someone
    # streaming, unread) stay within their own small box
    rules.append('#app-mount [class*="guilds_"] svg { background-size: min(28px, 100%) min(28px, 100%) !important; }')

    # Button-name matches: the animated icons live in an oversized, clipped box, so instead of
    # painting on the <svg> the icon is drawn on the button itself (a centred 20 px overlay) and
    # Discord's own drawing is hidden.
    for key, labels, checked, names in LABELS:
        f = custom_file(key) or lookup(themes, names, a.size)
        origin[key] = ("your pick" if f and f.startswith(CUSTOM) else theme, f)
        if not f:
            continue
        st = f'[aria-checked="{checked}"]' if checked else ''
        btn = [f'#app-mount [aria-label="{l}"]{st}' for l in labels]
        rules.append(
            f'{", ".join(btn)} {{ position: relative; }}\n'
            f'{", ".join(b + " svg" for b in btn)} {{ visibility: hidden !important; }}\n'
            f'{", ".join(b + "::after" for b in btn)} {{ content: ""; position: absolute; inset: 0; '
            f'pointer-events: none; background: url("{data_uri(f)}") center / 20px 20px no-repeat !important;{HALO} }}')

    os.makedirs(os.path.dirname(out), exist_ok=True)
    with open(out, "w") as fh:
        fh.write("/**\n * @name AeroIcons\n * @description Discord's icons from your Plasma icon theme, and emoji from your emoji font or emoticon pack "
                 f"({theme}). Generated by aerodark-discord-icons; re-run it after changing icon theme.\n"
                 " * @author TrulySc\n * @version 1.0.0\n */\n\n")
        fh.write("\n".join(rules) + "\n")
    os.makedirs(STATE, exist_ok=True)
    open(stamp, "w").write(stamp_text + "\n")
    os.makedirs(CUSTOM, exist_ok=True)
    cat = write_catalog(entries, origin, theme)
    # Messenger assets (the Messenger theme reads these variables; see README → Messenger)
    wlm_dir = os.path.join(DATA, "aerodark", "discord", "wlm")
    wlm_vars = []
    if os.path.isdir(wlm_dir):
        for n in sorted(os.listdir(wlm_dir)):
            stem, ext = os.path.splitext(n)
            if ext.lower() not in (".png", ".gif", ".jpg", ".webp") or not re.fullmatch(r"[\w-]+", stem):
                continue
            if stem.startswith("dp-") and stem != "dp-default":
                continue                                  # spare pictures: copy one to custom/me.png to use it
            wlm_vars.append(f'--wlm-img-{stem}: url("{data_uri(os.path.join(wlm_dir, n))}")')
    me = custom_file("me") or (own_discord_avatar() if not a.no_fetch_avatar else None)
    if me:
        wlm_vars.append(f'--wlm-me: url("{data_uri(me)}")')
    if wlm_vars:
        with open(out, "a", encoding="utf-8") as fh:
            fh.write("\n/* ── Messenger assets ── */\n:root {\n    " + ";\n    ".join(wlm_vars) + ";\n}\n")
    old_emoji = os.path.join(os.path.dirname(out), "AeroEmoji.theme.css")
    if os.path.exists(old_emoji):            # emoji now live in AeroIcons itself (one theme to enable)
        os.remove(old_emoji)
    if not a.no_emoji:
        write_emoji(out, a.emoji_font, here, append=True)
    left = len(entries) - from_theme - from_extra - from_custom
    print(f"aerodark-discord-icons: {from_custom} your picks, {from_theme} from {theme}, {from_extra} from "
          f"{EXTRA_THEME}, {left} left as Discord's → {out}")
    print(f"  catalog of every icon and its file name: {cat}")
    print(f"  your own icons go in: {CUSTOM}")
    if a.catalog:
        subprocess.run(["xdg-open", cat], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


if __name__ == "__main__":
    main()
