#!/usr/bin/env python3
"""
aerodark-discord-icons — give Discord (Vesktop) your Plasma icon theme.

Looks up each Discord icon in your current icon theme (the same lookup Plasma apps use, with
inheritance), and writes the matches into a Vencord theme, AeroIcons.theme.css. Icons your
theme doesn't have come from the AeroDiscord add-on icon set (the redrawn ones) if it's installed,
and otherwise stay as Discord drew them.

    aerodark-discord-icons                 regenerate for the current icon theme
    aerodark-discord-icons --if-changed    only if the icon theme changed since last time
    aerodark-discord-icons --theme NAME --size 24 --out FILE

Turn on "AeroIcons" in Vesktop → Settings → Vencord → Themes alongside Aero Light / Aero Dark.
aerodark-sync re-runs this automatically when you change icon theme.
"""
import argparse, base64, configparser, gzip, json, os, re, subprocess, sys

HOME = os.path.expanduser("~")
DATA = os.environ.get("XDG_DATA_HOME", os.path.join(HOME, ".local/share"))
CONF = os.environ.get("XDG_CONFIG_HOME", os.path.join(HOME, ".config"))
STATE = os.path.join(DATA, "aerodark")
CUSTOM = os.path.join(DATA, "aerodark", "discord", "custom")   # your hand-picked icons
HALO = ""
PACKS = os.path.join(DATA, "aerodark", "discord", "packs")           # icon packs to pick from
CUSTOM_EXT = ("png", "svg", "ico", "webp", "jpg", "jpeg", "gif")
EXTRA_THEME = "AeroDiscord"           # the add-on set with the redrawn Discord-only icons


def icon_bases():
    dirs = [os.path.join(DATA, "icons"), os.path.join(HOME, ".icons")]
    for d in os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share").split(":"):
        if d:
            dirs.append(os.path.join(d, "icons"))
    return [d for d in dict.fromkeys(dirs) if os.path.isdir(d)]


BASES = icon_bases()


def current_theme():
    try:
        out = subprocess.run(["kreadconfig6", "--file", "kdeglobals", "--group", "Icons", "--key", "Theme"],
                             capture_output=True, text=True).stdout.strip()
        if out:
            return out
    except FileNotFoundError:
        pass
    try:
        cp = configparser.ConfigParser(strict=False, interpolation=None)
        cp.read(os.path.join(CONF, "kdeglobals"))
        return cp.get("Icons", "Theme", fallback="breeze")
    except Exception:
        return "breeze"


class Theme:
    def __init__(self, name):
        self.name, self.roots, self.dirs, self.inherits = name, [], [], []
        for b in BASES:
            r = os.path.join(b, name)
            if os.path.isdir(r):
                self.roots.append(r)
        index = next((os.path.join(r, "index.theme") for r in self.roots
                      if os.path.isfile(os.path.join(r, "index.theme"))), None)
        if not index:
            return
        cp = configparser.ConfigParser(strict=False, interpolation=None)
        try:
            cp.read(index, encoding="utf-8")
        except Exception:
            return
        it = "Icon Theme"
        self.inherits = [x.strip() for x in cp.get(it, "Inherits", fallback="").split(",") if x.strip()]
        names = cp.get(it, "Directories", fallback="").split(",") + cp.get(it, "ScaledDirectories", fallback="").split(",")
        for d in dict.fromkeys(x.strip() for x in names if x.strip()):
            if not cp.has_section(d):
                continue
            g = lambda k, v: cp.get(d, k, fallback=v)
            size = int(g("Size", "0") or 0)
            self.dirs.append({
                "path": d, "size": size, "scale": int(g("Scale", "1") or 1), "type": g("Type", "Threshold"),
                "min": int(g("MinSize", size) or size), "max": int(g("MaxSize", size) or size),
                "thr": int(g("Threshold", "2") or 2)})

    def find(self, icon, want):
        """best file for `icon` near `want` px: exact size, then nearest larger, then scalable, then any"""
        best, best_score = None, None
        for d in self.dirs:
            for r in self.roots:
                folder = os.path.join(r, d["path"])
                for ext in ("png", "svg", "svgz"):
                    f = os.path.join(folder, f"{icon}.{ext}")
                    if not os.path.isfile(f):
                        continue
                    px = d["size"] * d["scale"]
                    if ext != "png":
                        score = (1, abs(d["size"] - want), d["scale"])  # vector: prefer the one drawn for this size
                    elif px == want:
                        score = (0, 0)
                    elif px > want:
                        score = (2, px - want)              # downscale a bigger bitmap
                    else:
                        score = (3, want - px)              # upscaling is last resort
                    if best_score is None or score < best_score:
                        best, best_score = f, score
        return best


def chain(name):
    seen, order, todo = set(), [], [name]
    while todo:
        n = todo.pop(0)
        if n in seen:
            continue
        seen.add(n)
        t = Theme(n)
        if t.roots:
            order.append(t)
            todo += t.inherits
    if "hicolor" not in seen:
        t = Theme("hicolor")
        if t.roots:
            order.append(t)
    return order


def lookup(themes, names, want):
    for t in themes:                     # whole theme chain for the first name, then the next name
        for n in names:
            f = t.find(n, want)
            if f:
                return f
    return None


def add_pack(src, name=None):
    """copy an icon pack (zip or folder) into PACKS/<name>, converting .ico to .png"""
    import shutil, tempfile, zipfile
    name = name or re.sub(r"^[0-9a-f]{6,}-", "", os.path.splitext(os.path.basename(src.rstrip("/")))[0])
    dst = os.path.join(PACKS, name)
    os.makedirs(dst, exist_ok=True)
    tmp = None
    if zipfile.is_zipfile(src):
        tmp = tempfile.mkdtemp()
        with zipfile.ZipFile(src) as z:
            for m in z.namelist():          # images only; nothing from the archive is run
                if re.search(r"\.(png|gif|ico|svg|webp|jpe?g)$", m, re.I) and "__MACOSX" not in m and ".." not in m:
                    z.extract(m, tmp)
        src = tmp
    try:
        from PIL import Image
    except ImportError:
        Image = None
    n = 0
    for root, _, files in os.walk(src):
        if "__MACOSX" in root:
            continue
        sub = os.path.relpath(root, src).replace(os.sep, "-").strip(".-")
        for f in files:
            stem, ext = os.path.splitext(f)
            ext = ext.lower()
            if ext not in (".png", ".gif", ".ico", ".svg", ".webp", ".jpg", ".jpeg"):
                continue
            out = re.sub(r"[^\w.&-]+", "_", (sub + "-" if sub else "") + stem)
            if ext == ".ico":
                if not Image:
                    continue
                try:
                    im = Image.open(os.path.join(root, f))
                    sizes = sorted(im.info.get("sizes", [im.size]), key=lambda s: s[0])
                    best = next((s for s in sizes if s[0] >= 64), sizes[-1])
                    im.size = best
                    im = im.convert("RGBA")
                    if im.width > 128:
                        im.thumbnail((128, 128), Image.LANCZOS)
                    im.save(os.path.join(dst, out + ".png"))
                except Exception:
                    continue
            else:
                shutil.copy(os.path.join(root, f), os.path.join(dst, out + ext))
            n += 1
    if tmp:
        shutil.rmtree(tmp, ignore_errors=True)
    print(f"Added {n} pictures to the pack '{name}' ({dst}).")


def apply_picks(path):
    """copy the pictures chosen in the catalog into the custom folder"""
    import shutil
    picks = json.load(open(path, encoding="utf-8"))
    os.makedirs(CUSTOM, exist_ok=True)
    base = os.path.join(DATA, "aerodark", "discord")
    n = 0
    for key, rel in picks.items():
        if not re.fullmatch(r"[\w-]+", key):
            continue
        src = os.path.realpath(os.path.join(base, rel))
        if not src.startswith(os.path.realpath(PACKS) + os.sep) or not os.path.isfile(src):
            continue
        for ext in CUSTOM_EXT:                       # replace an earlier pick for this icon
            old = os.path.join(CUSTOM, f"{key}.{ext}")
            if os.path.exists(old):
                os.remove(old)
        shutil.copy(src, os.path.join(CUSTOM, key + os.path.splitext(src)[1].lower()))
        n += 1
    print(f"Applied {n} picks.")


def own_discord_avatar():
    """Your own Discord picture, for Messenger's "you" display picture.

    Discord keeps the accounts you're signed into (id + avatar hash) in its local storage
    (MultiAccountStore); this reads that, downloads the picture from Discord's CDN once per change,
    and caches it. Returns a file path or None."""
    import glob, urllib.request
    cache_dir = os.path.join(STATE, "discord")
    os.makedirs(cache_dir, exist_ok=True)
    roots = [os.path.join(CONF, d) for d in ("vesktop/sessionData", "vesktop", "discord", "discordcanary",
                                               "discordptb", "Vencord", "legcord", "armcord")]
    blobs = []
    for r in roots:
        for f in glob.glob(os.path.join(r, "Local Storage", "leveldb", "*")):
            if f.endswith((".log", ".ldb")):
                try:
                    blobs.append(open(f, "rb").read())
                except OSError:
                    pass
    if not blobs:
        return None
    text = ""
    for b in blobs:
        text += b.decode("latin-1", "ignore") + "\n" + b.decode("utf-16-le", "ignore") + "\n"
    me = None
    m = re.findall(r'user_id_cache.{0,8}?"(\d{15,21})"', text)
    if m:
        me = m[-1]
    found = {}
    for obj in re.findall(r'\{[^{}]{0,400}?"avatar":"(?:a_)?[0-9a-f]{32}"[^{}]{0,400}?\}', text):
        i = re.search(r'"id":"(\d{15,21})"', obj)
        h = re.search(r'"avatar":"((?:a_)?[0-9a-f]{32})"', obj)
        if i and h:
            found[i.group(1)] = h.group(1)
    if not found:
        return None
    uid = me if me in found else next(iter(found))
    h = found[uid]
    dest = os.path.join(cache_dir, f"me-{uid}-{h}.png")
    if not os.path.isfile(dest):
        try:
            req = urllib.request.Request(f"https://cdn.discordapp.com/avatars/{uid}/{h}.png?size=128",
                                         headers={"User-Agent": "aerodark-discord-icons"})
            with urllib.request.urlopen(req, timeout=15) as r:
                data = r.read()
            for old in glob.glob(os.path.join(cache_dir, "me-*.png")):
                os.remove(old)
            open(dest, "wb").write(data)
        except Exception:
            olds = glob.glob(os.path.join(cache_dir, "me-*.png"))
            return olds[0] if olds else None
    return dest


def custom_file(*keys):
    """a hand-picked icon in the custom folder: 0024.png, 24.png, mic.svg, vc-platform-desktop.ico …"""
    for k in keys:
        for ext in CUSTOM_EXT:
            f = os.path.join(CUSTOM, f"{k}.{ext}")
            if os.path.isfile(f):
                return f
    return None


def custom_keys(e):
    i = e["id"]
    return [i, i.lstrip("0") or "0", e["slug"]] if i.isdigit() else [i, e["slug"]]


def custom_stamp():
    try:
        return ",".join(f"{n}:{int(os.path.getmtime(os.path.join(CUSTOM, n)))}" for n in sorted(os.listdir(CUSTOM)))
    except OSError:
        return ""


# KDE's monochrome SVG icons colour themselves from the colour scheme (class="ColorScheme-Text" with
# a placeholder colour). Plasma swaps in the real colours at runtime; a picture in Discord can't, so
# the swap is done here — otherwise those icons stay near-black, invisible on Aero Dark.
SCHEME_KEYS = {
    "Text": ("Colors:Window", "ForegroundNormal"), "Background": ("Colors:Window", "BackgroundNormal"),
    "Highlight": ("Colors:Selection", "BackgroundNormal"), "HighlightedText": ("Colors:Selection", "ForegroundNormal"),
    "PositiveText": ("Colors:Window", "ForegroundPositive"), "NegativeText": ("Colors:Window", "ForegroundNegative"),
    "NeutralText": ("Colors:Window", "ForegroundNeutral"), "ButtonText": ("Colors:Button", "ForegroundNormal"),
    "ButtonBackground": ("Colors:Button", "BackgroundNormal"), "ViewText": ("Colors:View", "ForegroundNormal"),
    "ViewBackground": ("Colors:View", "BackgroundNormal"), "ActiveText": ("Colors:Window", "ForegroundActive"),
}
_scheme = None


def scheme_colors():
    global _scheme
    if _scheme is None:
        _scheme = {}
        cp = configparser.ConfigParser(strict=False, interpolation=None)
        try:
            cp.read(os.path.join(CONF, "kdeglobals"), encoding="utf-8")
        except Exception:
            pass
        for name, (grp, key) in SCHEME_KEYS.items():
            v = cp.get(grp, key, fallback="")
            parts = [x.strip() for x in v.split(",")]
            if len(parts) >= 3 and all(x.isdigit() for x in parts[:3]):
                _scheme[name] = "#%02x%02x%02x" % tuple(int(x) for x in parts[:3])
    return _scheme


def recolor_svg(raw):
    txt = raw.decode("utf-8", "replace")
    if "ColorScheme-" not in txt:
        return raw
    cols = scheme_colors()
    txt = re.sub(r"(\.ColorScheme-(\w+)\s*\{[^}]*?color\s*:\s*)(#[0-9a-fA-F]{3,8}|[a-z]+)",
                 lambda m: m.group(1) + cols.get(m.group(2), m.group(3)), txt)
    return txt.encode("utf-8")


def data_uri(path):
    raw = open(path, "rb").read()
    if path.endswith(".svgz"):
        raw, mime = recolor_svg(gzip.decompress(raw)), "image/svg+xml"
    elif path.endswith(".svg"):
        raw, mime = recolor_svg(raw), "image/svg+xml"
    else:
        ext = path.rsplit(".", 1)[-1].lower()
        mime = {"ico": "image/x-icon", "webp": "image/webp", "jpg": "image/jpeg", "jpeg": "image/jpeg",
                "gif": "image/gif"}.get(ext, "image/png")
        if ext != "gif" and len(raw) > 24000:      # big pictures (icon packs): scale to 96 px for Discord
            try:
                import io
                from PIL import Image
                im = Image.open(io.BytesIO(raw))
                if max(im.size) > 96:
                    im = im.convert("RGBA")
                    im.thumbnail((96, 96), Image.LANCZOS)
                    buf = io.BytesIO()
                    im.save(buf, "PNG", optimize=True)
                    raw, mime = buf.getvalue(), "image/png"
            except Exception:
                pass
    return f"data:{mime};base64," + base64.b64encode(raw).decode()


