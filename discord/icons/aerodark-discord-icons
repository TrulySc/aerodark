def glyph_svg(e):
    paths = "".join(
        (f'<path fill="none" stroke="currentColor" stroke-width="{p["stroke"]}" d="{p["d"]}"/>' if "stroke" in p
         else f'<path fill="currentColor"{" fill-rule=" + chr(34) + p["rule"] + chr(34) if "rule" in p else ""} d="{p["d"]}"/>')
        for p in e["paths"])
    return f'<svg viewBox="{e["viewBox"]}">{paths}</svg>'


def write_catalog(entries, origin, theme):
    """an HTML page listing every icon: Discord's glyph, what replaces it now, and the file name to use"""
    import html as H
    path = os.path.join(DATA, "aerodark", "discord", "catalog.html")
    cards = []

    def card(key, title, glyph, sub, uri, src):
        now = f'<img src="{uri}" alt="" style="{HALO.strip()}">' if uri else '<span class="none">—</span>'
        tag = "t-pick" if src == "your pick" else ("t-theme" if src else "t-none")
        cards.append(f'<div class="c {tag}" data-key="{H.escape(key)}" data-k="{H.escape(key)} {H.escape(sub)}"><div class="g">{glyph}</div>'
                     f'<div class="n">{now}</div><b>{H.escape(title)}</b><code>{H.escape(key)}.png</code>'
                     f'<small>{H.escape(sub)}</small><i>{H.escape(src or "Discord’s own")}</i></div>')

    by_id = {e["id"]: e for e in entries}
    for key, labels, checked, names in LABELS:
        src, f = origin.get(key, (None, None))
        g = by_id.get(LABEL_GLYPH.get(key, ""))
        glyph = glyph_svg(g) if g else ""
        card(key, " / ".join(labels) + (" (on)" if checked else ""), glyph, "button: " + ", ".join(names),
             data_uri(f) if f else None, src if f else None)
    for e in entries:
        glyph = glyph_svg(e)
        src, f = origin.get(e["id"], (None, None))
        card(e["id"], "#" + e["id"], glyph, " ".join(e["names"]) or "Discord-only", data_uri(f) if f else None, src)

    packs_html = []
    if os.path.isdir(PACKS):
        for pk in sorted(os.listdir(PACKS)):
            d = os.path.join(PACKS, pk)
            if not os.path.isdir(d):
                continue
            imgs = sorted(f for f in os.listdir(d) if f.lower().endswith((".png", ".gif", ".svg", ".webp", ".jpg")))
            tiles = "".join(f'<img loading="lazy" src="packs/{H.escape(pk)}/{H.escape(f)}" title="{H.escape(f)}" '
                            f'data-p="packs/{H.escape(pk)}/{H.escape(f)}">' for f in imgs)
            packs_html.append(f'<details><summary>{H.escape(pk)} <small>({len(imgs)})</small></summary><div class="pk">{tiles}</div></details>')
    packs_block = "".join(packs_html) or ('<p class="mute">No packs yet. Add one with<br><code>aerodark-discord-icons '
                                         '--add-pack ~/Downloads/windows-7-icons.zip</code></p>')

    page = f"""<!doctype html><html><head><meta charset="utf-8"><title>Discord icon catalog</title><style>
:root{{color-scheme:light dark;--bg:#f0f0f0;--card:#fff;--line:#d9d9d9;--text:#000;--mute:#5a5a5a;--pick:#27ae27;--theme:#3c7fb1}}
@media (prefers-color-scheme:dark){{:root{{--bg:#1c1d1f;--card:#141516;--line:#2b2d30;--text:#ececec;--mute:#9a9da2}}}}
body{{margin:0;background:var(--bg);color:var(--text);font:9pt 'Segoe UI','Noto Sans',sans-serif}}
header{{position:sticky;top:0;background:var(--bg);padding:10px 16px;border-bottom:1px solid var(--line);display:flex;gap:12px;flex-wrap:wrap;align-items:center}}
header input{{font:inherit;padding:4px 6px;width:220px}} header p{{margin:0;color:var(--mute)}}
main{{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:8px;padding:16px}}
.c{{background:var(--card);border:1px solid var(--line);border-radius:3px;padding:8px;display:grid;grid-template-columns:1fr 1fr;gap:4px;align-items:center}}
.c.t-pick{{border-color:var(--pick);border-width:2px}} .c.t-theme{{border-color:var(--theme)}}
.g svg,.n img{{width:32px;height:32px;display:block;margin:auto}} .none{{display:block;text-align:center;color:var(--mute)}}
.c b,.c code,.c small,.c i{{grid-column:1/3;overflow-wrap:anywhere}} .c small,.c i{{color:var(--mute)}}
code{{user-select:all;cursor:copy}} .hide{{display:none}}
.wrap{{display:grid;grid-template-columns:1fr 380px;align-items:start}} main{{min-width:0}}
aside{{position:sticky;top:0;height:100vh;overflow:auto;border-left:1px solid var(--line);background:var(--card);padding:10px 12px;box-sizing:border-box}}
aside h3{{margin:4px 0 6px}} aside .mute,.mute{{color:var(--mute)}}
aside input{{font:inherit;padding:4px 6px;width:100%;box-sizing:border-box;margin-bottom:6px}}
aside summary{{cursor:pointer;padding:4px 0;font-weight:600}}
.pk{{display:grid;grid-template-columns:repeat(auto-fill,44px);gap:4px;padding:4px 0}}
.pk img{{width:40px;height:40px;object-fit:contain;padding:2px;border:1px solid transparent;border-radius:3px;cursor:pointer;background:var(--bg)}}
.pk img:hover{{border-color:var(--theme)}}
.c{{cursor:pointer}} .c.sel{{outline:2px solid var(--theme);outline-offset:1px}}
.c.t-new{{border-color:#e0a000;border-width:2px}}
.bar{{display:flex;gap:6px;flex-wrap:wrap;margin:6px 0}} .bar button{{font:inherit;padding:3px 10px}}
#cmd{{display:none;margin-top:6px}}
</style></head><body><header><b>Discord icons — {H.escape(theme)}</b>
<input id="q" placeholder="filter: number or name" autofocus>
<label><input type="checkbox" id="only"> only Discord's own (not replaced yet)</label>
<p>Left: Discord's icon. Right: what replaces it now. To use your own, save it as the file name shown
into <code>{H.escape(CUSTOM)}</code> (png, svg, ico, webp), then run <code>aerodark-discord-icons</code>.</p></header>
<div class="wrap"><main>{"".join(cards)}</main>
<aside><h3>Pick from your packs</h3>
<p class="mute">1. Click an icon on the left. 2. Click a picture here to use it. 3. Save your picks and run the
command shown. Your picks are remembered on this page until you save them.</p>
<div class="bar"><button id="save">Save picks</button><button id="clear">Clear picks</button><span id="count" class="mute"></span></div>
<div id="cmd" class="mute">Saved. Now run:<br><code>aerodark-discord-icons --apply-picks ~/Downloads/aerodark-picks.json</code></div>
<input id="pq" placeholder="filter pictures by file name">
{packs_block}</aside></div><script>
const q=document.getElementById('q'),o=document.getElementById('only');
function f(){{const t=q.value.toLowerCase().replace('#','');for(const c of document.querySelectorAll('.c'))
c.classList.toggle('hide',!(c.dataset.k.toLowerCase().includes(t))||(o.checked&&!c.classList.contains('t-none')));}}
q.oninput=f;o.onchange=f;
let picks={{}};try{{picks=JSON.parse(localStorage.getItem('aerodark-picks')||'{{}}')}}catch(e){{}}
let sel=null;
const store=()=>{{try{{localStorage.setItem('aerodark-picks',JSON.stringify(picks))}}catch(e){{}}
  document.getElementById('count').textContent=Object.keys(picks).length+' picked';}};
const show=c=>{{const p=picks[c.dataset.key];if(!p)return;const n=c.querySelector('.n');
  n.innerHTML='<img src="'+p+'">';c.classList.add('t-new');c.querySelector('i').textContent='new pick (not saved yet)';}};
document.querySelectorAll('.c').forEach(c=>{{show(c);c.onclick=()=>{{if(sel)sel.classList.remove('sel');sel=c;c.classList.add('sel');}};}});
document.querySelectorAll('.pk img').forEach(im=>im.onclick=()=>{{if(!sel){{alert('Click an icon on the left first.');return;}}
  picks[sel.dataset.key]=im.dataset.p;show(sel);store();}});
document.getElementById('pq').oninput=e=>{{const t=e.target.value.toLowerCase();
  document.querySelectorAll('.pk img').forEach(im=>im.style.display=im.title.toLowerCase().includes(t)?'':'none');}};
document.getElementById('save').onclick=()=>{{const a=document.createElement('a');
  a.href=URL.createObjectURL(new Blob([JSON.stringify(picks,null,1)],{{type:'application/json'}}));
  a.download='aerodark-picks.json';a.click();document.getElementById('cmd').style.display='block';}};
document.getElementById('clear').onclick=()=>{{if(confirm('Forget the picks on this page?')){{picks={{}};store();location.reload();}}}};
